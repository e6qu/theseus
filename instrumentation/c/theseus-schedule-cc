set -eu

usage() {
    echo 'usage: theseus-schedule-cc --process NAME --module NAME -o OUTPUT SOURCE.c [SOURCE.c ...]' >&2
    exit 2
}

process=
module=
output=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --process) [ "$#" -ge 2 ] || usage; process=$2; shift 2 ;;
        --module) [ "$#" -ge 2 ] || usage; module=$2; shift 2 ;;
        -o) [ "$#" -ge 2 ] || usage; output=$2; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done

case "$process" in ''|*[!A-Za-z0-9._-]*) usage ;; esac
case "$module" in ''|*[!A-Za-z0-9._-]*) usage ;; esac
[ "${#process}" -le 64 ] || usage
[ "${#module}" -le 64 ] || usage
[ -n "$output" ] || usage
[ "$#" -gt 0 ] || usage

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
inputs="$work/inputs"
sources="$work/sources"
: > "$inputs"
: > "$sources"
printf 'format=theseus-c-schedule-build-v1\nprocess=%s\nmodule=%s\n' \
    "$process" "$module" >> "$inputs"
printf 'compiler=%s\ntarget=%s\n' "$(gcc -dumpfullversion)" "$(gcc -dumpmachine)" >> "$inputs"
printf 'frontend=%s\n' "$(sha256sum "$tool_dir/theseus-schedule-cc" | awk '{print $1}')" >> "$inputs"
printf 'runtime=%s\n' "$(sha256sum "$tool_dir/theseus_schedule.c" | awk '{print $1}')" >> "$inputs"

source_count=0
for argument in "$@"; do
    if [ -f "$argument" ] && [ "${argument##*.}" = c ]; then
        name=$(basename -- "$argument")
        case "$name" in *[!A-Za-z0-9._-]*) usage ;; esac
        digest=$(sha256sum "$argument" | awk '{print $1}')
        source_count=$((source_count + 1))
        gcc -E -P "$argument" > "$work/preprocessed-$source_count"
        preprocessed=$(sha256sum "$work/preprocessed-$source_count" | awk '{print $1}')
        printf 'translation-unit=%s:%s:%s\n' "$name" "$digest" "$preprocessed" >> "$inputs"
        printf '%s %s %s\n' "$name" "$digest" "$preprocessed" >> "$sources"
    else
        usage
    fi
done
[ "$source_count" -gt 0 ] || usage

build_sha256=$(sha256sum "$inputs" | awk '{print $1}')
gcc -O2 -fPIC -pthread \
    -DTHESEUS_SCHEDULE_PROCESS=\"$process\" \
    -DTHESEUS_SCHEDULE_MODULE=\"$module\" \
    -DTHESEUS_SCHEDULE_BUILD_SHA256=\"$build_sha256\" \
    -c "$tool_dir/theseus_schedule.c" -o "$work/runtime.o"
gcc -O1 -g -fPIE -pie -pthread -fsanitize-coverage=trace-pc \
    "$@" "$work/runtime.o" \
    -Wl,--wrap=pthread_create -Wl,--wrap=pthread_join \
    -Wl,--wrap=pthread_mutex_lock -Wl,--wrap=pthread_mutex_unlock \
    -Wl,--wrap=pthread_cond_wait -Wl,--wrap=pthread_cond_signal \
    -Wl,--wrap=pthread_cond_broadcast \
    -ldl -o "$output"

manifest="${output}.theseus-schedule.json"
printf '{\n  "format": "theseus-c-schedule-build-v1",\n  "process": "%s",\n  "module": "%s",\n  "build_sha256": "%s",\n  "compiler": "%s",\n  "target": "%s",\n  "maximum_threads": 32,\n  "maximum_decisions": 8192,\n  "maximum_synchronization_events": 8192,\n  "maximum_synchronization_objects": 128,\n  "sources": [' \
    "$process" "$module" "$build_sha256" "$(gcc -dumpfullversion)" "$(gcc -dumpmachine)" > "$manifest"
separator=
while read -r name digest preprocessed; do
    printf '%s\n    {"name": "%s", "source_sha256": "%s", "preprocessed_sha256": "%s"}' \
        "$separator" "$name" "$digest" "$preprocessed" >> "$manifest"
    separator=,
done < "$sources"
printf '\n  ],\n  "controlled_pthread_operations": ["mutex_lock", "mutex_unlock", "cond_wait", "cond_signal", "cond_broadcast", "join"]\n}\n' >> "$manifest"

echo "$build_sha256  $output"
echo "$build_sha256  $manifest"
