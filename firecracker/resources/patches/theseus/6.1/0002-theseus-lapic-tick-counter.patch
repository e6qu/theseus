diff --git a/arch/x86/kernel/apic/apic.c b/arch/x86/kernel/apic/apic.c
--- a/arch/x86/kernel/apic/apic.c
+++ b/arch/x86/kernel/apic/apic.c
@@ -118,6 +118,9 @@ unsigned int lapic_timer_period = 0;
 
 static void apic_pm_activate(void);
 
+/* Theseus probe: the local APIC timer's interrupt counter. */
+static unsigned int theseus_lapic_tick_count;
+
 static unsigned long apic_phys __ro_after_init;
 
 /*
@@ -1091,7 +1094,19 @@ static void local_apic_timer_interrupt(void)
 	/*
 	 * the NMI deadlock-detector uses this.
 	 */
 	inc_irq_stat(apic_timer_irqs);
 
+	/*
+	 * Theseus probe: a periodic counter on the local APIC timer's
+	 * interrupt handler. When the timer deliveries ride the
+	 * userspace APIC, this names whether the injected vector's ISR
+	 * runs (the counter advances) or the delivery never reaches the
+	 * handler (the counter stands still).
+	 */
+	theseus_lapic_tick_count++;
+	if (!(theseus_lapic_tick_count % 16))
+		printk(KERN_INFO "theseus: lapic tick %u\n",
+		       theseus_lapic_tick_count);
+
 	evt->event_handler(evt);
 }
