#!/bin/busybox sh
set -eu
/bin/busybox mkdir -p /dev
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mkdir -p /proc
/bin/busybox mount -t proc proc /proc

# A Raspberry Pi exposes its UART as a TTY too (commonly ttyAMA0 or ttyS0).
# This guest's NS16550 UART is ttyS0. The kernel's interrupt account
# rides the debug channel: writing /proc/interrupts into /dev/kmsg makes
# the kernel emit it on every console - including the COM2 early console
# the halt-frontier probes retain. It never enters the machine stream,
# so replays stay exact.
if [ -w /dev/kmsg ]; then
  /bin/busybox cat /proc/interrupts > /dev/kmsg 2>&1 || true
fi
/bin/busybox stty -echo -opost </dev/ttyS0
printf 'THES:M:42\n' >/dev/ttyS0
IFS= read -r measurement </dev/ttyS0
printf 'sensor reading: %s\n' "$measurement" >/dev/ttyS0
printf 'THES:M:reboot\n' >/dev/ttyS0
/bin/busybox reboot -f
