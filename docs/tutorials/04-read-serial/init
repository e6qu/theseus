#!/bin/busybox sh
set -eu
/bin/busybox mkdir -p /dev
/bin/busybox mount -t devtmpfs devtmpfs /dev

# A Raspberry Pi exposes its UART as a TTY too (commonly ttyAMA0 or ttyS0).
# This guest's NS16550 UART is ttyS0. When the COM2 debug console exists,
# the kernel's interrupt account rides it - tick counts, UART counts - the
# halt-frontier probes read it from the retained debug log. COM2 output
# never enters the machine stream, so replays stay exact.
if [ -c /dev/ttyS1 ]; then
  cat /proc/interrupts >/dev/ttyS1 2>&1 || true
fi
/bin/busybox stty -echo -opost </dev/ttyS0
printf 'THES:M:42\n' >/dev/ttyS0
IFS= read -r measurement </dev/ttyS0
printf 'sensor reading: %s\n' "$measurement" >/dev/ttyS0
printf 'THES:M:reboot\n' >/dev/ttyS0
/bin/busybox reboot -f
