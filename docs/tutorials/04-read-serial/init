#!/bin/busybox sh
# No `set -x` here: the shell's traces write through /dev/console (which
# maps to ttyS0 in this initramfs), and the tty layer's TX flow control
# makes console bytes timing-dependent - the replay diverges at the
# first trace byte. Diagnostics ride /dev/kmsg instead: printk reaches
# the COM2 early console only, which the machine stream never records.
set -eu
kmsg() { /bin/busybox echo "init: $*" > /dev/kmsg 2>&1 || true; }
kmsg starting
/bin/busybox mkdir -p /dev
/bin/busybox mount -t devtmpfs devtmpfs /dev || kmsg devtmpfs mount failed
/bin/busybox mkdir -p /proc
/bin/busybox mount -t proc proc /proc || kmsg proc mount failed
/bin/busybox ls /dev/ttyS0 > /dev/kmsg 2>&1 || kmsg no ttyS0 node

# A Raspberry Pi exposes its UART as a TTY too (commonly ttyAMA0 or ttyS0).
kmsg stty next
/bin/busybox stty -echo -opost </dev/ttyS0 || kmsg stty failed
kmsg stty done
printf 'THES:M:42\n' >/dev/ttyS0
IFS= read -r measurement </dev/ttyS0
printf 'sensor reading: %s\n' "$measurement" >/dev/ttyS0
printf 'THES:M:reboot\n' >/dev/ttyS0
/bin/busybox reboot -f
